# Build artifacts and deps — rebuilt / reinstalled inside the image.
**/node_modules
**/target
# Exclude the WORKING out/ (runtime-generated, machine-specific) at the context
# root only — NOT seed/out, which ships the honest genesis proof artifacts the
# container stages into /app/out on first boot.
/out
web/dist
web/.next
web/_vite_legacy

# The image sparse-clones its own confidential subtree of OZ stellar-contracts;
# the local full clone (~2.3G) must never enter the build context.
reference

# VCS / env / local noise
.git
**/.env
**/.env.*
**/.DS_Store
**/*.log
contracts/target
